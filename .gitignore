.ruff_cache/
pgguardian.toml
.env
.env.local
.env.*.local

# --- Frontend / Node (generic) ---
node_modules/
.pnp/
.pnp.js
.npm
.eslintcache
.stylelintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
