{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Lets the pgGuardian shell launch its bundled FastAPI sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/pgguardian-desktop",
          "sidecar": true,
          "args": true
        }
      ]
    }
  ]
}
