{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PgGuardian",
  "version": "0.1.0",
  "identifier": "com.pgguardian.desktop",
  "build": {
    "frontendDist": "../frontend/out",
    "devUrl": "http://127.0.0.1:3000",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PgGuardian",
        "url": "index.html",
        "width": 1360,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/pgguardian-desktop"]
  }
}
